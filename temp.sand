t0 = getTime()

def fib(n) {
    if n == 0 {
        0
    } else {
        if n == 1 {
            1
        } else {
            a = 0
            b = 1
            i = 2
            while i <= n {
                temp = b
                b = a + b
                a = temp
                i = i + 1
            }
            b
        }
    }
}

raw = input()
n = int(raw)

result = fib(n)
print("Fib(", n, ") =", result)

t1 = getTime()
print("Time(ms):", t1 - t0)