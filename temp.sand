def fib(n) {
    if n == 0 {
        0
    } else {
        if n == 1 {
            1
        } else {
            a = 0
            b = 1
            i = 2
            while i <= n {
                next_fib = a + b
                a = b
                b = next_fib
                i = i + 1
            }
            b
        }
    }
}

t0 = getTime()

raw_input = input()
num = int(raw_input)

result = fib(num)

t1 = getTime()

print("Fibonacci(", num, "):", result)
print("Time(ms):", t1 - t0)