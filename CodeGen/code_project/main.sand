
// main.sand
from config import GameConfig
import Time

config = GameConfig.new
settings = config.getSettings()

// Generate a pseudo-random number using the current timestamp
// We use a large multiplier and modulo to fit the range
seed = int(Time.time() * 1000)
range_size = settings.max_val - settings.min_val + 1
secret_number = (seed % range_size) + settings.min_val

attempts = 0
max_attempts = settings.max_guesses
won = 0

print("==============================")
print("   GUESS THE NUMBER GAME      ")
print("==============================")
print("I have chosen a number between " + str(settings.min_val) + " and " + str(settings.max_val) + ".")
print("You have " + str(max_attempts) + " attempts to find it.")

while (attempts < max_attempts) {
    if (won == 0) {
        remaining = max_attempts - attempts
        print("")
        print("Attempts remaining: " + str(remaining))
        print("Please enter your guess:")
        
        user_input = input()
        guess = int(user_input)

        if (guess == secret_number) {
            print("Correct! " + str(guess) + " was the secret number!")
            won = 1
        } else {
            if (guess < secret_number) {
                print("Too low! Try a higher number.")
            } else {
                print("Too high! Try a lower number.")
            }
        }
        
        attempts = attempts + 1
    } else {
        // Exit loop early if won
        attempts = max_attempts
    }
}

print("")
if (won == 1) {
    print("Congratulations! You won in " + str(attempts) + " tries.")
} else {
    print("Game Over! You've run out of guesses.")
    print("The secret number was: " + str(secret_number))
}
print("==============================")
