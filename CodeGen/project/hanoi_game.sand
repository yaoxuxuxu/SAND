
// hanoi_game.sand
// Encapsulates the core game logic for Tower of Hanoi.
// This file will define the game state (pegs and disks),
// implement methods for initializing the game, validating
// and executing disk moves, and checking for the win condition.
class HanoiGame {
    num_disks = 0
    pegs = [] // A list of lists, where each inner list represents a peg and contains disk sizes.

    // Initializes the game with a specified number of disks.
    // Disks are placed on the first peg (peg 0) in decreasing order of size.
    def init(num_d) {
        num_disks = num_d
        pegs = [[], [], []] // 3 pegs (0, 1, 2)

        // Place disks on the first peg (index 0) from largest to smallest.
        // A larger number represents a larger disk.
        i = num_disks
        while (i > 0) {
            pegs[0].append(i)
            i = i - 1
        }
    }

    // Returns the total number of disks in the game.
    def get_num_disks() {
        num_disks
    }

    // Returns the current state of the pegs.
    // Each element in the outer list is a peg, containing a list of disk sizes.
    // The bottom-most disk is at index 0, and the top-most disk is at the last index.
    def get_pegs() {
        pegs
    }

    // Checks if a proposed move from one peg to another is valid according to Hanoi rules.
    def is_valid_move(from_peg_idx, to_peg_idx) {
        // 1. Validate peg indices are within bounds (0, 1, 2).
        if (from_peg_idx < 0 || from_peg_idx > 2) { return false }
        if (to_peg_idx < 0 || to_peg_idx > 2) { return false }

        // 2. Cannot move a disk from a peg to itself.
        if (from_peg_idx == to_peg_idx) { return false }

        // 3. A disk must be moved, so the source peg cannot be empty.
        if (pegs[from_peg_idx].length() == 0) { return false }

        // 4. The disk to be moved must be smaller than the disk it's placed on.
        // Get the top disk from the source peg.
        from_disk = pegs[from_peg_idx][pegs[from_peg_idx].length() - 1]

        // If the destination peg is empty, any disk can be moved to it.
        if (pegs[to_peg_idx].length() == 0) {
            return true
        } else {
            // Get the top disk from the destination peg.
            to_disk = pegs[to_peg_idx][pegs[to_peg_idx].length() - 1]
            // The disk being moved must be smaller than the destination's top disk.
            if (from_disk < to_disk) {
                return true
            } else {
                return false
            }
        }
    }

    // Executes a valid disk move from the source peg to the destination peg.
    // This method assumes the move has already been validated by is_valid_move.
    def make_move(from_peg_idx, to_peg_idx) {
        disk = pegs[from_peg_idx].pop() // Remove the top disk from the source peg
        pegs[to_peg_idx].append(disk)   // Add it to the top of the destination peg
    }

    // Checks if the game has been won.
    // The game is won when all disks are on the last peg (peg 2).
    def is_win() {
        pegs[2].length() == num_disks
    }
}
