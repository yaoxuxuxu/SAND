
from game_logic import GameLogic
from feedback import Feedback
from io_utils import IOUtils

// Initialize game components
game = GameLogic.new
feedback_gen = Feedback.new
io = IOUtils.new

// Get game settings from GameLogic
secret_number = game.get_secret_number()
min_range = game.get_min_range()
max_range = game.get_max_range()

io.print_message("Welcome to the Guess the Number game!")
io.print_message("I have chosen a secret number between " + str(min_range) + " and " + str(max_range) + ".")
io.print_message("Try to guess it!")
io.print_message("") // New line for better readability

guessed_correctly = false
num_guesses = 0

while (guessed_correctly == false) {
    guess_str = io.read_input("Enter your guess: ")
    
    // --- Input Validation ---
    // SAND does not provide robust string parsing or error handling for int() conversion.
    // We assume int() will work for valid numeric strings.
    // If a non-numeric string is entered, int() might cause a runtime error.
    
    // Attempt to convert input to an integer
    parsed_guess = int(guess_str) 

    // Check if the guess is within the allowed range
    if (parsed_guess < min_range or parsed_guess > max_range) {
        io.print_message("[ERROR] Your guess " + str(parsed_guess) + " is out of the valid range (" + str(min_range) + "-" + str(max_range) + "). Please try again.")
        continue // Skip the rest of the loop and ask for input again
    }

    num_guesses = num_guesses + 1

    // Check the guess using the game logic
    // status_info will be a list: [status, current_abs_diff, is_warmer, is_colder]
    // status: "correct", "low", "high"
    status_info = game.check_guess(parsed_guess) 
    
    // Generate and display feedback
    feedback_message = feedback_gen.get_feedback(status_info)
    io.print_message(feedback_message)
    io.print_message("") // New line for better readability

    // Check if the guess was correct
    if (status_info[0] == "correct") {
        guessed_correctly = true
    }
}

io.print_message("Congratulations! You guessed the number " + str(secret_number) + " in " + str(num_guesses) + " guesses!")
io.print_message("Thanks for playing!")

