
from fortune_engine import FortuneEngine
from fortunes import FortuneData

// Main entry point for the Fortune Generator application
class FortuneApp {
    def start() {
        // Instantiate the data and engine
        data = FortuneData.new
        engine = FortuneEngine.new
        
        // Initialize the random seed using system time
        engine.initSeed()

        print("Welcome to the Mystical Fortune Generator!")
        print("------------------------------------------")
        
        // Personalization
        print("Please enter your name, seeker:")
        name = input()
        
        print("Hello, " + name + ". What area of your life seek you guidance in?")
        print("Categories: Love, Career, Health, General, or 'Random' for any.")
        category = input()

        // Coordinate the fortune generation
        // We pass the fortunes data and the desired category to the engine
        fortune = engine.generate(data.getFortunes(), category)

        print("------------------------------------------")
        print("Greetings, " + name + "!")
        print("The stars have spoken: " + fortune)
        print("------------------------------------------")
        print("May your path be clear!")
    }
}

// Execution
app = FortuneApp.new
app.start()
