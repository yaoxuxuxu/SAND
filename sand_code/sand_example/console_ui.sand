//console_ui.sand
class Formatter {
    width = 40

    def repeat(ch, n) {
        s = ""
        i = 0
        while (i < n) {
            s = s + ch
            i = i + 1
        }
        s
    }

    def line() {
        print(this.repeat("-", width))
    }

    def header(title) {
        this.line()
        print("| " + title)
        this.line()
    }
}

class ConsoleUI extends Formatter {

    def printRow(row) {
        id    = row[0]
        name  = row[1]
        price = row[2]
        stock = row[3]
        print("[" + str(id) + "] " + name +
              "  price:" + str(price) +
              "  stock:" + str(stock))
    }

    def listAll(rows) {
        this.header("Product List")
        i = 0
        while (i < rows.length()) {
            this.printRow(rows[i])
            i = i + 1
        }
        this.line()
    }

    def printItem(item) {
        if (item == -1) {
            print("[not found]")
        } else {
            print("Found: [" + str(item.id) + "] " + item.name +
                  "  price:" + str(item.price) +
                  "  stock:" + str(item.stock))
        }
    }

    def printStats(s) {
        this.header("Statistics")
        print("total products : " + str(s.count))
        print("total stock    : " + str(s.total_stock))
        print("most stocked id: " + str(s.best_id))
        this.line()
    }

    def makePrinter(prefix) {
        lambda(msg){ print(prefix + msg) }
    }
}