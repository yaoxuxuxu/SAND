
def solve(n, start, step) {
    result = []
    current_val = start
    current_step = step
    count = 0
    while (count < n) {
        result.append(current_val)
        // Check if the current element is a multiple of 10.
        // Using (val / 10) * 10 == val to check for multiples of 10.
        if ((current_val / 10) * 10 == current_val) {
            current_step = current_step * -1
        }
        current_val = current_val + current_step
        count = count + 1
    }
    result
}
