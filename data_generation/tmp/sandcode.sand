
class FibCalculator {
    def calculate(n) {
        res = 0
        if (n == 0) {
            res = 0
        } else {
            if (n == 1) {
                res = 1
            } else {
                a = 0
                b = 1
                i = 2
                while (i <= n) {
                    temp = a + b
                    a = b
                    b = temp
                    i = i + 1
                }
                res = b
            }
        }
        res
    }
}

calc = FibCalculator.new
solve = lambda(n) {
    calc.calculate(n)
}
